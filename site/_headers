# Cloudflare Pages headers
# This file is only used by Cloudflare. The Node server (server/server.mjs)
# sets its own equivalents for Manus hosting.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://js.stripe.com; frame-src https://js.stripe.com https://buy.stripe.com https://api.leadconnectorhq.com https://api.zoom.us; connect-src 'self' https://api.stripe.com https://*.leadconnectorhq.com; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Long-lived immutable caching for versioned static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/manus-storage/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and images that never change content
/*.svg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800

# HTML must always be revalidated so price and date changes appear immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# The redirects and robots files are configuration, not content
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# Security and privacy headers on the API
/api/*
  Cache-Control: no-store